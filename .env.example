# --- AI provider ---------------------------------------------------
# "openai" (default) or "demo". With "openai", both OPENAI_API_KEY and
# OPENAI_MODEL must be set or the app falls back to the demo provider.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Model name is intentionally not hardcoded anywhere in the code.
# Pick a current model from https://platform.openai.com/docs/models
OPENAI_MODEL=

# "quality" (Observer -> Writer -> Editor, default) or "fast" (one call)
AI_QUALITY_MODE=quality

# --- Branding ------------------------------------------------------
# Working title; rename here (and in lib/config.ts fallback) before launch.
NEXT_PUBLIC_APP_NAME=Zhvanetsky

# --- Self-improvement ---------------------------------------------
# Where feedback events + the learned style live (default ./.improve-data;
# production uses a mounted volume, e.g. /data).
IMPROVE_DATA_DIR=
# Enables /api/admin/* (feedback export, style promote/rollback).
# Unset = admin endpoints disabled.
IMPROVE_ADMIN_TOKEN=
# For `npm run improve` against a deployed instance:
IMPROVE_REMOTE_URL=
